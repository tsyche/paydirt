# PayDirt environment — copy to .env and fill in values
# Never commit .env to git

# Ports: this repo owns 3110-3119 (web 3110, PocketBase 3111, ephemeral test PocketBase 3112).
# Hardcoded in justfile, apps/web/package.json and Playwright config; change them together.

# PocketBase backend (local dev; point to VPS URL in production)
POCKETBASE_URL=http://localhost:3111

# Mobile app — PocketBase URL for the Expo build
# Emulator default (10.0.2.2 = host machine alias): leave as-is for emulator testing
# Physical device: replace with your machine's LAN IP (e.g. http://192.168.1.50:3111)
#   Find it with: ipconfig getifaddr en0  (macOS Wi-Fi)
EXPO_PUBLIC_POCKETBASE_URL=http://10.0.2.2:3111

# PocketBase admin (for migrations / seed scripts — local dev only)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme

# ntfy notifications
# Public ntfy.sh for now; self-hosted on VPS later
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=paydirt-changeme
