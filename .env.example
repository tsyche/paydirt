# PayDirt environment — copy to .env and fill in values
# Never commit .env to git

# PocketBase backend (local dev; point to VPS URL in production)
POCKETBASE_URL=http://localhost:8090

# PocketBase admin (for migrations / seed scripts — local dev only)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme

# ntfy notifications
# Public ntfy.sh for now; self-hosted on VPS later
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=paydirt-changeme
