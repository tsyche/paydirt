<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- PocketBase is plain HTTP on a LAN IP (self-hosted, no TLS) and the IP comes
       from apps/mobile/.env — permit cleartext outright so a DHCP change never
       needs this file edited in lockstep. HTTPS (ntfy.sh) is unaffected: trust
       anchors keep their system defaults. -->
  <base-config cleartextTrafficPermitted="true" />
</network-security-config>
