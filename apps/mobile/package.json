    "@react-native-community/datetimepicker": "9.3.0",
    "eslint": "^10.14.0",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.32",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.21",
