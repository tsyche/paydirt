[Unit]
Description=PayDirt (PocketBase backend + parent dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paydirt
WorkingDirectory=/opt/paydirt
ExecStart=/opt/paydirt/pocketbase serve \
    --dir /var/lib/paydirt \
    --hooksDir /opt/paydirt/pb_hooks \
    --migrationsDir /opt/paydirt/pb_migrations \
    --publicDir /opt/paydirt/pb_public \
    --http 0.0.0.0:3111
# Optional overrides (NTFY_SERVER, NTFY_DISABLED, ...); see docs/DEPLOYMENT.md.
EnvironmentFile=-/etc/paydirt/paydirt.env
Environment=NTFY_QUEUE_DIR=/var/lib/paydirt/notifications
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paydirt

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/paydirt

# Resource limits
# Approval hooks and realtime-triggered reads arrive in bursts.
CPUQuota=200%
CPUWeight=200
Nice=0
# No effect under kyber (bb's /var/lib/paydirt SSD); only honoured by BFQ.
IOSchedulingClass=best-effort
IOSchedulingPriority=4
# Collect Go heaps before the hard limit forces synchronous reclaim/swap.
Environment=GOMEMLIMIT=512MiB
MemoryMax=768M
# Needs the parent slice's MemoryLow (system.slice-paydirt-memory.conf); a child's is capped by it.
MemoryLow=256M

[Install]
WantedBy=multi-user.target
